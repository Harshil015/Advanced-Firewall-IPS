#!/usr/sbin/nft -f

flush ruleset

table inet firewall {
    set honeypot_bans {
        type ipv4_addr
        flags timeout
        timeout 1h
    }

    set rate_limit_bans {
        type ipv4_addr
        flags timeout
        timeout 1h
    }

    chain input {
        type filter hook input priority 0; policy drop;

        # 1. Allow localhost
        iif "lo" accept

        # 2. Allow established/related
        ct state established,related accept

        # 3. Drop banned IPs (Honeypot & Rate Limit)
        ip saddr @honeypot_bans drop
        ip saddr @rate_limit_bans drop

        # 4. GeoIP Blocking (Requires nftables geoip support)
        # ip saddr geoip CN,RU drop

        # 5. Rate Limiting for SSH (Port 22)
        tcp dport 22 meter port22 { ip saddr limit rate over 5/minute } add @rate_limit_bans { ip saddr } drop

        # 6. Honeyports (2222, 8080, 9999)
        tcp dport { 2222, 8080, 9999 } add @honeypot_bans { ip saddr } log prefix "HONEYPORT ALERT: " drop

        # 7. Allow specific inbound services (e.g., HTTP/HTTPS)
        tcp dport { 80, 443 } accept
    }

    chain forward {
        type filter hook forward priority 0; policy drop;
    }

    chain output {
        type filter hook output priority 0; policy accept;
    }
}
